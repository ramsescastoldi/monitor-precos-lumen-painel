scrape-petrobras.mjs
scrape-volumes.mjs
export-radar.mjs
check-freshness.mjs
update.mjs
package.json
package-lock.json
bun.lock
bun.lockb

# Config legada (Netlify)
netlify.toml

# Config Cloudflare auto-gerada
wrangler.jsonc
wrangler.toml

# Docs
README.md
*.md

# Ignore o próprio ignore
.assetsignore
graphify-out/
